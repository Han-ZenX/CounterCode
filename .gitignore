# =====================================================
# GitIgnore for Xilinx Vivado/SDK FPGA Project
#
# Pattern anchoring, because several rules used to silently do nothing:
#   - A pattern with a slash anywhere but the end is anchored to this
#     file's directory. A pattern with no slash matches at any depth.
#   - Vivado names generated directories after the project
#     (top_cymometer.cache, top_cymometer.hw, ...), not .cache / .hw,
#     so those rules need a "*." prefix.
#   - SDK build output lives at top_cymometer.sdk/<app>/Debug/, so the
#     rule needs "**/" - a bare "Debug/*" only matches /Debug/ at the root.
# =====================================================

# =====================================================
# Vivado Generated Files and Directories
# =====================================================
*.cache/
*.hw/
*.ip_user_files/
*.runs/
*.sim/
*.tmp/
.Xil/
*.jou
*.log
*.str
backup*

# Vivado project files
*.xpr.user
*.xcsa
XilInitFiles.1.tcl/

# =====================================================
# Xilinx SDK / Eclipse Workspace State
# =====================================================
.metadata/
RemoteSystemsTempFiles/
webtalk/
.settings/
.cdtsettings
.core
.executable
.locks
.msystem
.launch
*.launch
*.tmptools
*.tclproj
*.cproject.user
*.elf.bootimage
*.elf.user
*.elf.symbols
*.srec
*.mcs
*.pdi

# BSP makefiles are regenerated by the SDK.
# Careful: this matches a file named "Makefile" at ANY depth, so a
# hand-written Makefile added later would be ignored without warning.
Makefile

# .project is deliberately NOT listed here. Eclipse/SDK needs it to import
# the projects; previously only .cproject was tracked, which is not enough
# for a fresh clone to open the workspace.

# =====================================================
# SDK Build Output
# =====================================================
**/Debug/*
!**/Debug/.gitignore

# Keep the linked ELFs: BOOT.bin is produced from them and they are already
# tracked. Remove the next line to keep build products out of the repository.
!**/Debug/*.elf

# =====================================================
# SD Card Deployment Files
# =====================================================
# .bin and .bit are deployment artifacts and must stay tracked. Nothing above
# ignores them; these negations are defensive, in case a broad *.bin is ever
# added. (The old "sd_card/!*.bin" form was wrong - "!" only negates at the
# start of a pattern, so it matched files literally starting with "!".)
!sd_card/*.bin
!sd_card/*.bit
sd_card/*.hex

# =====================================================
# IP Repository Management
# =====================================================
ip_repo/*/hdl/build/
ip_repo/*/src/build/
ip_repo/*/impl/
ip_repo/*/msgs/

# Managed IP Projects
managed_ip_project*/

# =====================================================
# Simulation and Synthesis Outputs
# =====================================================
behavioral/
physical/
synth_1/
implement_1/
simulate_1/
*.vcd
*.wdb
*.shmem
*.lwp
*.wif
wave*.shm
sim*.xml

# =====================================================
# Build Artifacts
# =====================================================
BitGen.log
glbl.v
hierarchical_timing.xml
par_report_summary.html
phys_opt_design_report.html
pld_template.jed
program_hw_ucf.tcl
timing_routed.rpt
unisims.sh
utilization.rpt
usage.xml

# =====================================================
# IDE and Editor Files
# =====================================================
# Visual Studio Code
.vscode/**
*.code-workspace

# Sublime Text
*.sublime-project
*.sublime-workspace

# Emacs
*~
\#*\#
.emacs.desktop
.elc

# Vim
*.swp
*.swo
*.state
.nodetags

# =====================================================
# Operating System Files
# =====================================================
# macOS
.DS_Store
.AppleDouble
.Spotlight-V100
.Trashes
__MACOSX

# Linux
.*.swp
.swap

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
desktop.ini
$RECYCLE.BIN/
NTFS$

# =====================================================
# Logs and Debugging
# =====================================================
# *.log above already covers hs_err_pid*.log and the JVM crash logs in the
# project root; the explicit entries are kept for clarity.
*.trace
hs_err_pid*.log
hs_err_pid*.dmp
error_log.txt
crash_dump.txt

# =====================================================
# Temporary and Backup Files
# =====================================================
*.bak
*.orig
*.temp
*.new
~*.txt
*_old/*
_backup/
archive/

# =====================================================
# Specific to this Frequency Meter Project
# =====================================================
# Reference clock calibration data. Device specific - each board has its own
# measured value, so it should not be shared through the repository.
FREQ.TXT
clk_fs_freq.txt
*.data
measurement_*.csv

# Generated configuration files
generated_config.h
local_override.tcl
custom_settings.tcl

# =====================================================
# Documentation (optional - uncomment to exclude)
# =====================================================
# *.pdf
# *.html
# /docs/build/

# =====================================================
# Deliberately Kept In The Repository
# =====================================================
# - .gitignore, README.md
# - doc/ and protocols/ markdown
# - All .v, .tcl, .xdc sources
# - All SDK sources (.c/.h under src/), plus lscript.ld and system.mss
# - .project and .cproject - both are needed to import the SDK projects
# - top_cymometer.xpr and top_cymometer.srcs/ (project and block design)
# - ps_wrapper.hdf (hardware handoff the SDK builds against)
# - sd_card/*.bin and sd_card/*.bit (deployment artifacts)
#
# Removed from the previous revision:
# - ".sdk/" never matched (the directory is top_cymometer.sdk). It was
#   dropped rather than "fixed" to *.sdk/, which would have excluded every
#   SDK source file in the project.
# - ".project" was excluding a file the SDK needs.
# - Duplicate "*.tmp/" and "Thumbs.db" entries.
