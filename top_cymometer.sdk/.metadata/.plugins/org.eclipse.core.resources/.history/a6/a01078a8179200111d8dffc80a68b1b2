int ReadFr(char * Freq)
{
	u32 nyquist_limit = GetClkFsFreq() / 2; // 156.25 MHz
	u32 safe_limit = nyquist_limit * 0.9;
	if (FREF > safe_limit)
	{
		return ReadFr_TDC(Freq);//等精度法，无奈奎斯特限制
	}
	else
	{
		return ReadFr_TimestampMode(Freq); //时间戳法，高精度
	}
}

double ReadStartT(char * Freq)
{
	u32 cnt_gate_time;

	double db_gate_time;

	int n_gate_time;

	double db_sleep_time;

	unsigned long sleep_time;

	db_gate_time = (((double)FREF * (START_GATE_TIME/1000))-10);

	db_sleep_time = START_GATE_TIME * 1000;

	sleep_time = (unsigned long)db_sleep_time;

	n_gate_time = (int)db_gate_time;

	cnt_gate_time = (u32)n_gate_time;

	SetCntGateMax(cnt_gate_time);

	u32 cnt_clk_stand_reg_1;

	u32 cnt_clk_test_reg_1;

	double Fr = 0;

	SetRESET(1);

	usleep(10); //寤舵椂10us

	SetRESET(0);

	SetGATE(1);

	usleep(sleep_time); //寤舵椂100000us = 100ms

	SetGATE(0);

	usleep(10); //寤舵椂10us

	cnt_clk_stand_reg_1 = TOP_CYMOMETER_IP_mReadReg(TOP_CYMOMETER_IP_BASEADDR,TOP_CYMOMETER_IP_REG16);
	cnt_clk_test_reg_1 = TOP_CYMOMETER_IP_mReadReg(TOP_CYMOMETER_IP_BASEADDR,TOP_CYMOMETER_IP_REG17);
	Fr = ((double)GetClkFsFreq() * (double)cnt_clk_test_reg_1 / (double)cnt_clk_stand_reg_1);

	sprintf(Freq,"%.5f\n",Fr);

	return Fr;
}

void InitStartT(void *p)
{
	u32 START_T = 0;

	START_T_TIME = 0;

	START_T_END = 0;

	double Freq;
	double Fref;

	double StartT = 0;

	double FRppm;

	while(1)
	{
		START_T = TOP_CYMOMETER_IP_mReadReg(TOP_CYMOMETER_IP_BASEADDR,TOP_CYMOMETER_IP_REG18);
		if(START_T==1)
		{
			for(int i=0;i<1000;i++)
			{
				char Fr[300];
				Freq = ReadStartT(Fr);
				Freq = Freq * 4;
				Fref = (double)FREF * 4;

				FRppm = (Freq - Fref)/Fref * 1000000;

				StartT = (START_GATE_TIME + 0.02 )* (i+1);

				if(FRppm >= (-1 * (double)PPM) && FRppm <= (double)PPM)
				{
					START_T_TIME = StartT;
					START_T_END = 1;
					return;
				}
			}

			START_T_TIME = StartT;
			START_T_END = 1;
			break;
		}
	}

	START_T_END = 1;
	return;
}

