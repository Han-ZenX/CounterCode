//============================================================================
// ReadFr_TDC - ReadFr with TDC sub-cycle correction
//
// TDC correction formula (绛夌簿搴︽祴棰戞硶):
//   eff_stand = cnt_stand + tdc_ref_rise/64 - tdc_ref_fall/64
//   eff_test  = cnt_test  + tdc_test_rise/64 - tdc_test_fall/64
//   Fr = (eff_test / eff_stand) * CLK_FS_FREQ
//
// This eliminates the 卤1 counter quantization error on both sides,
// improving resolution from ~1ppm to <0.001ppm (100ms gate).
//============================================================================
int ReadFr_TDC(char * Freq)
{
	double db_sleep_time;
	unsigned long sleep_time;

	db_sleep_time = GATE_TIME * 1000;
	sleep_time = (unsigned long)db_sleep_time;

	u32 cnt_clk_stand_reg_1;
	u32 cnt_clk_test_reg_1;

	double Fr;

	SetRESET(1);
	usleep(10);
	SetRESET(0);

	SetGATE(1);
	usleep(sleep_time);
	SetGATE(0);
	usleep(10);

	// 绛夌簿搴︽祴棰戞硶 + TDC鏍℃
	cnt_clk_stand_reg_1 = TOP_CYMOMETER_IP_mReadReg(TOP_CYMOMETER_IP_BASEADDR, TOP_CYMOMETER_IP_REG16);
	cnt_clk_test_reg_1 = TOP_CYMOMETER_IP_mReadReg(TOP_CYMOMETER_IP_BASEADDR, TOP_CYMOMETER_IP_REG17);

	// Read TDC values
	u32 tdc_rise_ref = ReadTdcRefRise();
	u32 tdc_fall_ref = ReadTdcRefFall();
	u32 tdc_rise_test = ReadTdcTestRise();
	u32 tdc_fall_test = ReadTdcTestFall();

	// TDC鏍℃: 鏈夋晥璁℃暟 = 鏁存暟璁℃暟 + 璧峰灏忔暟 - 缁撴潫灏忔暟
	double eff_stand = (double)cnt_clk_stand_reg_1
		+ (double)tdc_rise_ref / (double)TDC_NUM_TAPS
		- (double)tdc_fall_ref / (double)TDC_NUM_TAPS;

	double eff_test = (double)cnt_clk_test_reg_1
		+ (double)tdc_rise_test / (double)TDC_NUM_TAPS
		- (double)tdc_fall_test / (double)TDC_NUM_TAPS;

	// 纭繚鏈夋晥璁℃暟涓烘鏁�
	if (eff_stand > 0 && eff_test > 0)
		Fr = ((double)GetClkFsFreq() * eff_test / eff_stand);
	else
		Fr = ((double)GetClkFsFreq() * (double)cnt_clk_test_reg_1 / (double)cnt_clk_stand_reg_1);

	sprintf(Freq, "%.5f\n", Fr);

	return 0;
}

//============================================================================
// Timestamp Engine - Continuous Dead-Time-Free Measurement
//============================================================================

int ReadTimestamps(double *timestamps, int max_count, int edge_skip)
{
	u32 status, fifo_entries;

	// Step 1: Reset timestamp engine (ts_reset=1, ts_enable=0)
	TOP_CYMOMETER_IP_mWriteReg(TOP_CYMOMETER_IP_BASEADDR, TOP_CYMOMETER_IP_REG23, 0x2);
	// Reset FIFO read pointer to match write pointer (both at 0)
	TOP_CYMOMETER_IP_mWriteReg(TOP_CYMOMETER_IP_BASEADDR, TOP_CYMOMETER_IP_REG26, 0);
	usleep(100);

	// Step 2: Set edge_skip
	TOP_CYMOMETER_IP_mWriteReg(TOP_CYMOMETER_IP_BASEADDR, TOP_CYMOMETER_IP_REG24, (u32)edge_skip);

	// Step 3: Enable timestamp engine (ts_enable=1, ts_reset=0)
	TOP_CYMOMETER_IP_mWriteReg(TOP_CYMOMETER_IP_BASEADDR, TOP_CYMOMETER_IP_REG23, 0x1);
	usleep(100); // CDC sync delay

	// Step 4: Wait for measurement (use configured gate time)
	double sleep_time_us = GATE_TIME * 1000.0;
	if (sleep_time_us < 1000.0) // minimum 1ms for stability
		sleep_time_us = 1000.0;
	usleep((unsigned long)sleep_time_us);

	// Step 5: Disable engine (FIFO contents preserved)
	TOP_CYMOMETER_IP_mWriteReg(TOP_CYMOMETER_IP_BASEADDR, TOP_CYMOMETER_IP_REG23, 0x0);
	usleep(100);

	// Step 6: Read FIFO status - bits [10:0] = entry count
	status = TOP_CYMOMETER_IP_mReadReg(TOP_CYMOMETER_IP_BASEADDR, TOP_CYMOMETER_IP_REG25);
	fifo_entries = status & 0x7FF;

	if (fifo_entries > (u32)max_count)
		fifo_entries = (u32)max_count;

	// Step 7: Read FIFO entries sequentially
	for (u32 i = 0; i < fifo_entries; i++) {
		TOP_CYMOMETER_IP_mWriteReg(TOP_CYMOMETER_IP_BASEADDR, TOP_CYMOMETER_IP_REG26, i);
		u32 cnt_val = TOP_CYMOMETER_IP_mReadReg(TOP_CYMOMETER_IP_BASEADDR, TOP_CYMOMETER_IP_REG27);
		u32 tdc_val = TOP_CYMOMETER_IP_mReadReg(TOP_CYMOMETER_IP_BASEADDR, TOP_CYMOMETER_IP_REG28) & 0x3F;
		timestamps[i] = ((double)cnt_val + (double)tdc_val / 64.0) / (double)GetClkFsFreq();
	}

	return (int)fifo_entries;
}

double ComputeFreqFromTimestamps(double *timestamps, int count)
{
	if (count < 3)
		return 0.0;

	// Unwrap timestamps to handle potential 32-bit counter wrap-around
	double period = (double)0x100000000ULL / (double)GetClkFsFreq(); // ~13.7s
	for (int i = 1; i < count; i++) {
		if (timestamps[i] < timestamps[i-1]) {
			timestamps[i] += period;
		}
	}

	// Linear regression: t[i] = a + b*i
	// slope b = (N*sum(i*t) - sum(i)*sum(t)) / (N*sum(i^2) - (sum(i))^2)
	double sum_i = 0.0, sum_t = 0.0, sum_it = 0.0, sum_i2 = 0.0;
	for (int i = 0; i < count; i++) {
		sum_i  += (double)i;
		sum_t  += timestamps[i];
		sum_it += (double)i * timestamps[i];
		sum_i2 += (double)i * (double)i;
	}

	double N = (double)count;
	double denom = N * sum_i2 - sum_i * sum_i;
	if (fabs(denom) < 1e-30)
		return 0.0;

	double slope = (N * sum_it - sum_i * sum_t) / denom;

	// slope is in seconds per edge
	// freq = 1 / (slope * (edge_skip + 1))
	// edge_skip + 1 is accounted for by the caller
	if (slope <= 0.0)
		return 0.0;

	return 1.0 / slope;
}

int ReadFr_TimestampMode(char *Freq)
{
	static double timestamps[1024]; // static to avoid FreeRTOS stack overflow (8KB)

	// Adaptive edge_skip: target ~500 entries in FIFO
	int edge_skip = 0;
	if (FREF > 0) {
		int expected_edges = (int)((double)FREF * (GATE_TIME / 1000.0));
		if (expected_edges > 500)
			edge_skip = expected_edges / 500 - 1;
		if (edge_skip < 0)
			edge_skip = 0;
	}

	// Read timestamps
	int count = ReadTimestamps(timestamps, 1024, edge_skip);

	// If FIFO was nearly full, retry with higher edge_skip
	if (count >= 1020 && edge_skip < 10000) {
		edge_skip = edge_skip * 2 + 1;
		count = ReadTimestamps(timestamps, 1024, edge_skip);
	}

	if (count < 3) {
		sprintf(Freq, "0.00000\n");
		return -1;
	}

	// Compute frequency from linear regression
	double freq = ComputeFreqFromTimestamps(timestamps, count);
	freq *= (double)(edge_skip + 1);

	sprintf(Freq, "%.5f\n", freq);
	return 0;
}

